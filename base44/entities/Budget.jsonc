{
  "name": "Budget",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "budget_type": {
      "type": "string",
      "enum": [
        "internal",
        "lender",
        "other"
      ],
      "default": "internal"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "source_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "name"
  ],
  "rls": {
    "create": null,
    "read": true,
    "update": true,
    "delete": true
  }
}