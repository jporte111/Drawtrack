{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "budget_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "track_lenders": {
      "type": "boolean",
      "default": true
    },
    "track_vouchers": {
      "type": "boolean",
      "default": true
    },
    "retention_enabled": {
      "type": "boolean",
      "default": false
    },
    "retention_rate": {
      "type": "number",
      "default": 10
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": {},
    "update": true,
    "delete": true
  }
}