{
  "name": "Document",
  "type": "object",
  "properties": {
    "draw_vendor_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "invoice",
        "receipt",
        "conditional_lien_release",
        "unconditional_lien_release"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "missing",
        "pending_signature",
        "needs_correction",
        "pending_payment",
        "complete",
        "na"
      ],
      "default": "missing"
    },
    "file_url": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "invoice_number": {
      "type": "string"
    },
    "received_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "draw_vendor_id",
    "document_type"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}