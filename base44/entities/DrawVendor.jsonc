{
  "name": "DrawVendor",
  "type": "object",
  "properties": {
    "draw_cycle_id": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "scope_of_work": {
      "type": "string"
    },
    "budget_category_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "payment_recipient": {
      "type": "string",
      "enum": [
        "vendor",
        "jlm",
        "mike",
        "jose"
      ],
      "default": "vendor"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "documents_requested",
        "documents_received",
        "under_review",
        "complete"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "draw_cycle_id",
    "vendor_id"
  ],
  "rls": {
    "create": null,
    "read": true,
    "update": true,
    "delete": true
  }
}