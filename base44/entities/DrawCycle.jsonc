{
  "name": "DrawCycle",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "submitted",
        "under_review",
        "funded",
        "closed"
      ],
      "default": "draft"
    },
    "draw_date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "draw_manager": {
      "type": "string"
    },
    "approver": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_required"
    },
    "lender_current_payment_due": {
      "type": "number"
    },
    "application_cert_url": {
      "type": "string"
    },
    "continuation_sheet_url": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "project_name",
    "client_id"
  ],
  "rls": {
    "create": null,
    "read": true,
    "update": true,
    "delete": true
  }
}