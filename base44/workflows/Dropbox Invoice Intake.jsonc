{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dropbox_invoice_intake",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "intake": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dropboxIntake",
            "args": {
              "folder_path": "/NAMASTE/CLIENTS"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Poll Dropbox vendor folders",
            "description": "Per client/project/vendor \u2192 draw cycle"
          }
        }
      }
    ]
  },
  "description": "Polls each client's Dropbox folder every hour and imports invoice files from <client folder>/Clients/<project>/Vendors/<vendor>/ into the matching draw cycle. Base folder: /NAMASTE/CLIENTS.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Dropbox Invoice Intake"
}