{
  "name": "Create Open Item on Document Update",
  "description": "When a Document's status changes to Missing, Pending Signature, Needs Correction, or Pending Payment, automatically creates (or updates) an Open Item linked to the document's Draw Vendor and Draw Cycle. The Open Item title reflects the current status and document type.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Document",
      "events": [
        "update"
      ]
    },
    "condition": "${ (.trigger.data.status == \"missing\" or .trigger.data.status == \"pending_signature\" or .trigger.data.status == \"needs_correction\" or .trigger.data.status == \"pending_payment\") and (.trigger.changed_fields | index(\"status\") != null) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "create_open_item_on_document_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "create_open_item": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createOpenItemFromDocument",
            "args": {
              "document_id": "${ .trigger.entity_id }",
              "draw_vendor_id": "${ .trigger.data.draw_vendor_id }",
              "document_type": "${ .trigger.data.document_type }",
              "status": "${ .trigger.data.status }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Create Open Item",
            "description": "From document status change"
          }
        }
      }
    ]
  }
}