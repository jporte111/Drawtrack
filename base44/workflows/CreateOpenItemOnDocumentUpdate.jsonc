{
  "name": "Create Open Item on Document Update",
  "description": "When a Document's status changes to a non-complete, non-N/A value, automatically creates an Open Item linked to the document's Draw Vendor and Draw Cycle. The Open Item title is set based on the document type (Invoice, Conditional lien release, or Unconditional lien release).",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Document",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status != \"complete\" and .trigger.data.status != \"na\" and (.trigger.changed_fields | index(\"status\") != null) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "create_open_item_on_document_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "create_open_item": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createOpenItemFromDocument",
            "args": {
              "document_id": "${ .trigger.entity_id }",
              "draw_vendor_id": "${ .trigger.data.draw_vendor_id }",
              "document_type": "${ .trigger.data.document_type }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Create Open Item",
            "description": "From document status change"
          }
        }
      }
    ]
  }
}